<Window x:Class="POSSystem.TransactionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POSSystem"
        mc:Ignorable="d"
        Title="TransactionHistoryWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
		<StackPanel>
			<ListBox x:Name="HistoryList" Height="250" />
			<Button Content="View / Print Receipt" Height="40" Click="View_Click" />
		</StackPanel>
    </Grid>
</Window>
