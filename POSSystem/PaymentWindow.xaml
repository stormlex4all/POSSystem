<Window x:Class="POSSystem.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POSSystem"
        mc:Ignorable="d"
        Title="PaymentWindow" Height="450" Width="800">
	<Grid>
		<StackPanel Margin="20">
			<TextBlock Text="PAYMENT" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" />
			<TextBlock x:Name="TotalText" FontSize="18" FontWeight="Bold" Margin="0,10" />
			<TextBlock Text="Cash Given:" FontSize="14" />
			<TextBox x:Name="CashInput" Height="40" FontSize="16" Margin="0,5,0,10" />
			<Button Content="Calculate Change" Height="40" Margin="0,5" Click="Calculate_Click" />
			<TextBlock x:Name="ChangeText" FontSize="16" FontWeight="Bold" Margin="0,10" />

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
				<Button Content="Confirm" Width="100" Margin="5" Click="Confirm_Click" />
				<Button Content="Cancel" Width="100" Margin="5" Click="Cancel_Click" />
			</StackPanel>

		</StackPanel>
	</Grid>
</Window>
