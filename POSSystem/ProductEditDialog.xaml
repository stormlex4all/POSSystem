<Window x:Class="POSSystem.ProductEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product Details" Height="500" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="NoResize">
    
    <Border Background="White" CornerRadius="4" Margin="15" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" 
                       x:Name="HeaderText"
                       Text="ADD NEW PRODUCT" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Foreground="#2196F3"
                       Margin="0,0,0,20"/>

            <!-- Form Fields -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Product Name:" FontWeight="SemiBold" Margin="0,5"/>
                    <TextBox x:Name="NameTextBox" 
                             Height="35"
                             Padding="8"
                             FontSize="14"/>

                    <TextBlock Text="Price ($):" FontWeight="SemiBold" Margin="0,15,0,5"/>
                    <TextBox x:Name="PriceTextBox" 
                             Height="35"
                             Padding="8"
                             FontSize="14"/>

                    <TextBlock Text="Stock Quantity:" FontWeight="SemiBold" Margin="0,15,0,5"/>
                    <TextBox x:Name="StockTextBox" 
                             Height="35"
                             Padding="8"
                             FontSize="14"/>

                    <TextBlock Text="Category:" FontWeight="SemiBold" Margin="0,15,0,5"/>
                    <ComboBox x:Name="CategoryComboBox" 
                              Height="35"
                              Padding="8"
                              FontSize="14">
                        <ComboBoxItem Content="Food"/>
                        <ComboBoxItem Content="Beverages"/>
                        <ComboBoxItem Content="Snacks"/>
                        <ComboBoxItem Content="18+"/>
                        <ComboBoxItem Content="Misc"/>
                    </ComboBox>

                    <TextBlock Text="Barcode (Optional):" FontWeight="SemiBold" Margin="0,15,0,5"/>
                    <TextBox x:Name="BarcodeTextBox" 
                             Height="35"
                             Padding="8"
                             FontSize="14"/>

                    <CheckBox x:Name="AgeVerificationCheckBox" 
                              Content="Requires Age Verification (18+)" 
                              Margin="0,20"
                              FontSize="14"
                              FontWeight="SemiBold"/>

                    <Border Background="#FFF3E0" 
                            CornerRadius="4" 
                            Padding="10"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="⚠️ Note:" 
                                       FontWeight="Bold" 
                                       Foreground="#F57C00"/>
                            <TextBlock Text="Age verification items require customer to be 18+ years old during purchase." 
                                       TextWrapping="Wrap"
                                       Foreground="#F57C00"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons -->
            <UniformGrid Grid.Row="2" Columns="2" Margin="0,20,0,0">
                <Button Content="💾 Save" 
                        Click="Save_Click"
                        Margin="0,0,5,0"
                        Height="45"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="10">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#388E3C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="✖ Cancel" 
                        Click="Cancel_Click"
                        Margin="5,0,0,0"
                        Height="45"
                        Background="#757575"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="10">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#616161"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </UniformGrid>
        </Grid>
    </Border>
</Window>
