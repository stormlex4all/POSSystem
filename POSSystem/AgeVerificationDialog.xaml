<Window x:Class="POSSystem.AgeVerificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Age Verification Required" Height="370" Width="451"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="NoResize">

    <Border Background="White" CornerRadius="4" Margin="15" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="⚠️ AGE VERIFICATION REQUIRED" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="#FF9800"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <TextBlock Text="This product requires the customer to be 18 years or older." 
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Foreground="#666666"/>
            </StackPanel>

            <Border Grid.Row="1" 
                    Background="#FFF3E0" 
                    CornerRadius="4" 
                    Padding="15">
                <StackPanel>
                    <TextBlock Text="Customer's Age:" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,10"/>
                    <TextBox x:Name="AgeTextBox" 
                             Height="52" 
                             FontSize="16"
                             TextAlignment="Center"
                             Padding="5" Width="349"/>
                    <TextBlock x:Name="ValidationTextBlock" 
                               Text="" 
                               Foreground="Red" 
                               Margin="0,10"
                               TextWrapping="Wrap" Height="36"/>
                </StackPanel>
            </Border>

            <UniformGrid Grid.Row="2" Columns="2" Margin="0,20,0,0">
                <Button Content="✓ Verify" 
                        Click="Verify_Click"
                        Margin="0,0,5,0"
                        Height="40"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="✖ Cancel" 
                        Click="Cancel_Click"
                        Margin="5,0,0,0"
                        Height="40"
                        Background="#F44336"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </UniformGrid>
        </Grid>
    </Border>
</Window>
